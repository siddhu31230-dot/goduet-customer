# =============================================================================
# GODUET SHARED BACKEND ENVIRONMENT CONFIGURATION (CUSTOMER WEB PORTAL)
# Region: AWS Mumbai (ap-south-1)
# =============================================================================

# Public Client Credentials (Safe for browser code via Next.js NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...public-anon-key...

# Server-Side Privileged Key (STRICT: NEVER expose in browser code or prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key...

# Encryption Master Key for Student IDs and Addresses at rest
ENCRYPTION_MASTER_KEY=goduet_aes_256_gcm_master_key_hyderabad_2026_secure

# Session Signing Secret (Used for HMAC signed cookies & tokens)
SESSION_SECRET=goduet_session_hmac_signing_secret_2026

# Payment Gateway (Razorpay India)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
PAYMENT_WEBHOOK_SECRET=goduet_payment_webhook_secret_hyderabad_2026

# Fast2SMS Gateway Configuration
FAST2SMS_API_KEY=your_fast2sms_api_key_here
ENABLE_LIVE_SMS_BILLING=false
